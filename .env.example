# ============================================================================
# AI Platform — Environment Variables (EXAMPLE ONLY)
# ============================================================================
# Copy this file to `.env.local` for development and fill in real values.
#
# ⚠️ SECURITY RULES:
#   1. NEVER commit a real .env.local — `.gitignore` already excludes it
#   2. NEVER prefix server-only secrets with `NEXT_PUBLIC_` (they'd leak
#      to the browser bundle). Server-only vars:
#        - SUPABASE_SERVICE_ROLE_KEY
#        - UPSTASH_REDIS_REST_URL / _TOKEN
#        - RESEND_API_KEY
#        - EMAIL_FROM
#   3. Rotate any key that has ever been pasted into chat, screenshots,
#      or untrusted CI logs.
# ============================================================================

# ===== Supabase =====
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key  # ⚠️ SERVER ONLY

# ===== Site =====
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ===== Feature flags =====
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG_MODE=false  # ⚠️ Keep false in production

# ===== Upstash (rate limiting + cache) — optional =====
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXxx...

# ===== Resend (transactional email) — optional =====
# RESEND_API_KEY=re_xxx...
# EMAIL_FROM=newsletter@aiplatform.com

# ===== Optional integrations =====
# OPENAI_API_KEY=your-openai-key        # SERVER ONLY
# STRIPE_SECRET_KEY=sk_live_xxx         # SERVER ONLY
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
# CRON_SECRET=random_secret_for_cron_jobs
